#
# SeaBSD is a desktop-oriented distribution built on FreeBSD. This config
# starts from GENERIC and adds what desktop users need, with a comment for
# every change explaining *why* it is here.
#
# NOTE: the Linux binary compatibility layer (linuxolator) does NOT require
# kernel config options. It is delivered by loadable modules (linux.ko,
# linux64.ko) enabled at runtime via rc.conf/loader.conf, so it stays out of
# this file on purpose.

include "GENERIC"

ident SEABSD

# --- SeaBSD desktop additions ---------------------------------------------

# Read Linux ext2/ext3/ext4 volumes: external drives and dual-boot setups are
# a desktop reality, and data rescue should not require another OS.
options EXT2FS

# GEOM ELI (geli) is the foundation of SeaBSD full-disk encryption. Building
# it in removes a boot-time chicken-and-egg problem for encrypted roots.
options GEOM_ELI

