# Enable the Linux binary compatibility layer (linuxolator) on SeaBSD.
# SeaBSD treats Linux applications as a first-class product surface:
# see docs/linuxolator.md for the plan and current status.

# Load linux.ko / linux64.ko at boot.
linux_enable="YES"

